{
  "manifest_version": 3,
  "name": "LLT - LANGUAGE LEARNER TOOLKIT",
  "version": "1.1",
  "description": "Provides as series of tools for helping when learning russia, english and swedish. Provider two tts models, PIPER and google for prounication, word look up on wiktionary and wikidata, and quick search on wikipedia, wiktionary, yandex and google and fetching word definition.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "tts",
    "storage",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "App settings"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "lib/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "lib/ort.wasm.min.js",
        "lib/piper_phonemize.min.js",
        "dist/contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}