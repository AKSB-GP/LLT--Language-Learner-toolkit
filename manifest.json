{
  "manifest_version": 3,
  "name": "LLT - LANGUAGE LEARNER TOOLKIT",
  "version": "1.1",
  "description": "Provides as series of tools for helping when learning russia, english and swedish. Provides tts models, Word look up, Fetching word definitions and saving words to CSV",
  "permissions": [
    "contextMenus",
    "activeTab",
    "tts",
    "storage",
    "notifications",
    "scripting"
  ],
  "commands": {
    "pronounce-with-piper-tts": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Pronounce highlighted word with Natural AI TTS"
    },
    "translate-with-google": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Translate highlighted word with google translate"
    },
    "get-definition-of-word": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Get definition of highlighted word"
    },
    "open-youglish-of-word": {
      "description": "Open Youglish of highlighted word"
    },
    "pronounce-with-google-tts": {
      "description": "Pronounce highlighted word with Google TTS"
    },
    "open-wikitionary-of-word": {
      "description": "Open Wikitionary of highlighted word"
    },
    "save-word-to-vocabulary": {
      "description": "Save highlighted word to vocabulary",
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      }
    }
  },
  "icons": {
    "32": "icons/LLT_icon_32.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "App settings"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "lib/*",
        "dist/sql-wasm.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "llt-toolkit@language-learner.org",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "scripts": [
      "dist/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "lib/ort.wasm.min.js",
        "lib/piper_phonemize.min.js",
        "dist/contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}