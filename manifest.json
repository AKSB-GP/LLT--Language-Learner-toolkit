{
  "manifest_version": 3,
  "name": "TTS Word Highlighter",
  "version": "1.1",
  "description": "Highlight Russian words on any webpage. Click to pronounce them using Piper TTS ONNX.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "notfication",
    "tts",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "App settings"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "lib/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "lib/ort.min.js",
        "lib/piper_phonemize.min.js",
        "contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}