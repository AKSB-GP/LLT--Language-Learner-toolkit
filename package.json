{
  "name": "ru-word-highlighter",
  "version": "1.1.0",
  "description": "Highlight Russian words and play them via Piper TTS",
  "main": "dist/contentScript.js",
  "scripts": {
    "build": "esbuild src/contentScript.ts src/background.ts src/popup.ts --bundle --loader:.css=text --outdir=dist --target=chrome100 --sourcemap --external:node:fs/promises --external:node:crypto --external:node:path --external:node:stream && node -e \"require('fs').copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm', 'dist/sql-wasm.wasm')\"",
    "package": "npm run build && node scripts/package.js",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/chrome": "^0.0.260",
    "@types/sql.js": "^1.4.11",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.2",
    "onnxruntime-web": "^1.14.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ankipack": "^0.3.1",
    "anylang": "^3.4.1",
    "eld": "^2.0.3",
    "sql.js": "^1.14.2"
  },
  "allowScripts": {
    "anylang@3.4.1": true
  }
}
