    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "esbuild": "^0.20.1",
    "onnxruntime-web": "^1.14.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "eld": "^2.0.3"
  }
}
